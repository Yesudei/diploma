NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Server-only chat model settings for /api/chat.
# Options: gemini, openai-compatible, ollama
CHAT_PROVIDER=openai-compatible
CHAT_MODEL=your-model-name

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible providers: OpenAI, OpenRouter, Groq, Together, etc.
# For OpenRouter:
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_API_KEY=your-openrouter-key
# CHAT_MODEL=anthropic/claude-3.5-haiku
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# OpenAI direct also works through the OpenAI-compatible path:
# OPENAI_API_KEY=your-openai-key
# CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Groq direct also works through the OpenAI-compatible path:
# GROQ_API_KEY=your-groq-key
# CHAT_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=

# Local Ollama, no hosted rate limit:
# CHAT_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional. Defaults to ../rag-dataset-builder/data/ready/rag_ready_mn.jsonl
RAG_DATASET_PATH=
